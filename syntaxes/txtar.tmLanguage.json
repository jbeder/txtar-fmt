{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Txtar",
  "scopeName": "source.txtar",
  "patterns": [
    {
      "include": "#file-go"
    },
    {
      "include": "#file-python"
    },
    {
      "include": "#file-javascript"
    },
    {
      "include": "#file-typescript"
    },
    {
      "include": "#file-json"
    },
    {
      "include": "#file-yaml"
    },
    {
      "include": "#file-markdown"
    },
    {
      "include": "#file-html"
    },
    {
      "include": "#file-css"
    },
    {
      "include": "#file-shell"
    },
    {
      "include": "#file-java"
    },
    {
      "include": "#file-c"
    },
    {
      "include": "#file-cpp"
    },
    {
      "include": "#file-rust"
    },
    {
      "include": "#file-xml"
    },
    {
      "include": "#file-generic"
    },
    {
      "include": "#comment"
    }
  ],
  "repository": {
    "file-go": {
      "begin": "^(--\\s+)(.*\\.go)(\\s+--\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.file-marker.txtar"
        },
        "2": {
          "name": "entity.name.filename.txtar"
        },
        "3": {
          "name": "punctuation.definition.file-marker.txtar"
        }
      },
      "end": "^(?=--\\s+.+?\\s+--\\s*$)|\\Z",
      "contentName": "meta.embedded.block.go",
      "patterns": [
        {
          "include": "source.go"
        }
      ]
    },
    "file-python": {
      "begin": "^(--\\s+)(.*\\.py)(\\s+--\\s*)$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.file-marker.txtar"
